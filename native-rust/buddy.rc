#include "buddy-version.h"

101 ICON "buddy.ico"
1 24 "buddy.manifest"

1 VERSIONINFO
FILEVERSION BUDDY_VERSION_NUM
PRODUCTVERSION BUDDY_VERSION_NUM
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Buddy\0"
      VALUE "FileVersion", BUDDY_VERSION_STR
      VALUE "InternalName", "Buddy\0"
      VALUE "OriginalFilename", "Buddy.exe\0"
      VALUE "ProductName", "Buddy\0"
      VALUE "ProductVersion", BUDDY_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
